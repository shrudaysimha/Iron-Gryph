# Sample environment variables for the Incident Detection Engine.
# Copy this file to `.env` and fill in real values as needed.

# ── Hospital Location ──
# HOSPITAL_LATITUDE=12.9716
# HOSPITAL_LONGITUDE=77.5946
# HOSPITAL_NAME=Demo Hospital — Bengaluru

# ── Weather API (OpenWeatherMap) ──
# Get a free key at https://openweathermap.org/api
# WEATHER_API_KEY=your_openweathermap_api_key_here

# ── Events API (optional) ──
# EVENTS_API_KEY=
# EVENTS_API_URL=

# ── Scoring Thresholds ──
# HIGH_RISK_THRESHOLD=70.0
# MODERATE_RISK_THRESHOLD=35.0

# ── Server ──
# API_PORT=8000
# DEBUG=True
