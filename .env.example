# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/hospital_surge_ai
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:password@localhost:5432/hospital_surge_ai

# App
APP_NAME=Hospital Surge AI
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key

# Server
HOST=0.0.0.0
PORT=8000

# External APIs
OPENWEATHER_API_KEY=your_openweathermap_api_key
WEATHER_CITY=Bangalore
WEATHER_COUNTRY=IN

# ML Model
MODEL_RETRAIN_INTERVAL_HOURS=24
PREDICTION_HORIZON_HOURS=24

# Alert Thresholds
BED_OCCUPANCY_WARNING=0.80
BED_OCCUPANCY_CRITICAL=0.90
STAFF_RATIO_MIN=0.15
AMBULANCE_AVAILABLE_MIN=2
